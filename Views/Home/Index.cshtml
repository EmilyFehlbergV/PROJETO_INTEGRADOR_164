
@{
    Layout = null;
    ViewData["Title"] = "Início - Visto por Mim";
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content="Visto por Mim: encontre informações sobre acessibilidade." />
    <meta name="theme-color" content="#f8f7fc" />
    <title>Início - Visto por Mim</title>

    <style>
        :root {
            --roxo: #7545d6;
            --roxo-escuro: #5630aa;
            --lilas: #f0eaff;
            --fundo: #f8f7fc;
            --texto: #28243b;
            --texto-suave: #77748b;
            --borda: #ece9f4;
            --branco: #ffffff;
            --verde: #e5f6ed;
            --sombra: 0 8px 28px rgba(49, 35, 91, 0.06);
        }

        * {
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
            scroll-padding-top: 90px;
            -webkit-text-size-adjust: 100%;
        }

        body {
            margin: 0;
            background: var(--fundo);
            color: var(--texto);
            font-family: Arial, Helvetica, sans-serif;
            font-size: 15px;
            line-height: 1.5;
        }

        button, input, a {
            font: inherit;
        }

        a {
            color: inherit;
            text-decoration: none;
        }

        button {
            cursor: pointer;
        }

        button:focus-visible,
        a:focus-visible,
        input:focus-visible {
            outline: 3px solid #b6a0f6;
            outline-offset: 3px;
        }

        .pular-conteudo {
            position: absolute;
            top: -100px;
            left: 12px;
            z-index: 100;
            padding: 12px 16px;
            background: white;
            color: var(--roxo-escuro);
            border-radius: 10px;
        }

        .pular-conteudo:focus {
            top: 12px;
        }

        .cabecalho {
            position: sticky;
            top: 0;
            z-index: 20;
            background: rgba(255, 255, 255, 0.96);
            border-bottom: 1px solid var(--borda);
            backdrop-filter: blur(12px);
        }

        .cabecalho-interno {
            width: min(1180px, calc(100% - 48px));
            min-height: 76px;
            margin: 0 auto;
            display: flex;
            align-items: center;
            justify-content: space-between;
            gap: 24px;
        }

        .marca {
            display: inline-flex;
            align-items: center;
            gap: 10px;
            flex-shrink: 0;
            color: var(--texto);
            font-size: 19px;
            font-weight: 800;
            letter-spacing: -0.5px;
        }

        .marca-icone {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border-radius: 13px;
            color: white;
            background: linear-gradient(135deg, #8c62ec, #6338c3);
            font-size: 22px;
            box-shadow: 0 4px 10px #7545d625;
        }

        .menu {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 7px;
            flex-wrap: wrap;
        }

        .menu-link {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            min-height: 40px;
            padding: 9px 12px;
            border-radius: 10px;
            color: #69657b;
            font-size: 13px;
            font-weight: 600;
            transition: background 0.2s, color 0.2s;
        }

        .menu-link:hover {
            color: var(--roxo);
            background: #f5f0ff;
        }

        .menu-link.ativo {
            color: var(--roxo-escuro);
            background: var(--lilas);
        }

        .menu-perfil {
            width: 39px;
            height: 39px;
            display: grid;
            place-items: center;
            border: 1px solid #e3d9fb;
            border-radius: 50%;
            background: #f0eaff;
            color: var(--roxo-escuro);
            font-weight: 800;
        }

        .sair-form {
            margin: 0;
        }

        .menu-sair {
            padding: 9px 12px;
            border: 1px solid #eee7fb;
            border-radius: 10px;
            background: white;
            color: #66538e;
            font-size: 13px;
            font-weight: 600;
        }

        .menu-sair:hover {
            background: #f8f4ff;
        }

        .pagina {
            width: min(1180px, calc(100% - 48px));
            margin: 0 auto;
            padding: 32px 0 48px;
        }

        .boas-vindas {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
            margin-bottom: 27px;
        }

        .boas-vindas p {
            margin: 0 0 5px;
            color: var(#77748b);
            font-size: 14px;
        }

        .boas-vindas h1 {
            margin: 0;
            font-size: clamp(25px, 3vw, 33px);
            line-height: 1.2;
            letter-spacing: -1px;
        }

        .boas-vindas h1 span {
            color: var(--roxo);
        }

        .aviso-demo {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 9px 12px;
            border: 1px solid #e9e0ff;
            border-radius: 12px;
            background: #f4efff;
            color: #6b4bb1;
            font-size: 12px;
            font-weight: 600;
        }

        .hero-pesquisa {
            position: relative;
            overflow: hidden;
            padding: clamp(25px, 5vw, 44px);
            margin-bottom: 34px;
            border-radius: 24px;
            background: linear-gradient(120deg, #eee7ff, #f7f3ff 65%, #e8eaff);
            border: 1px solid #e8defe;
        }

        .hero-pesquisa::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            right: -75px;
            top: -110px;
            border: 38px solid rgba(133, 99, 218, 0.07);
            border-radius: 50%;
            pointer-events: none;
        }

        .hero-conteudo {
            position: relative;
            z-index: 1;
            max-width: 760px;
        }

        .etiqueta {
            display: inline-block;
            margin-bottom: 12px;
            color: var(--roxo-escuro);
            font-size: 11px;
            font-weight: 800;
            letter-spacing: 1.4px;
        }

        .hero-pesquisa h2 {
            max-width: 650px;
            margin: 0 0 10px;
            font-size: clamp(28px, 4.2vw, 43px);
            line-height: 1.12;
            letter-spacing: -1.4px;
        }

        .hero-pesquisa .descricao {
            max-width: 580px;
            margin: 0 0 25px;
            color: #6e6882;
            font-size: 15px;
            line-height: 1.7;
        }

        .pesquisa-form {
            display: flex;
            align-items: center;
            gap: 10px;
            max-width: 760px;
            padding: 7px;
            border: 1px solid #e8e2f2;
            border-radius: 15px;
            background: white;
            box-shadow: 0 7px 24px rgba(65, 44, 119, 0.07);
        }

        .pesquisa-icone {
            padding-left: 10px;
            color: var(--roxo);
            font-size: 24px;
        }

        .pesquisa-form input {
            flex: 1;
            width: 100%;
            min-width: 0;
            padding: 12px 5px;
            border: 0;
            outline: none;
            background: transparent;
            color: var(--texto);
            font-size: 14px;
        }

        .pesquisa-form input:focus-visible {
            outline: 2px solid #b6a0f6;
            outline-offset: 1px;
            border-radius: 5px;
        }

        .pesquisa-form input::placeholder {
            color: #9691a7;
        }

        .botao-principal {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            min-height: 45px;
            padding: 12px 20px;
            border: 0;
            border-radius: 11px;
            background: var(--roxo);
            color: white;
            font-weight: 700;
            font-size: 13px;
            transition: background 0.2s, transform 0.2s;
        }

        .botao-principal:hover {
            background: var(--roxo-escuro);
            transform: translateY(-1px);
        }

        .texto-demo {
            margin: 12px 0 0;
            color: #807795;
            font-size: 11px;
        }

        .secao {
            margin-top: 35px;
        }

        .secao-cabecalho {
            display: flex;
            justify-content: space-between;
            align-items: flex-end;
            gap: 18px;
            margin-bottom: 19px;
        }

        .secao-cabecalho h2 {
            margin: 0;
            font-size: 21px;
            letter-spacing: -0.5px;
        }

        .secao-cabecalho p {
            margin: 5px 0 0;
            color: var(#77748b);
            font-size: 13px;
        }

        .link-ver-mais {
            flex-shrink: 0;
            color: var(--roxo);
            font-size: 13px;
            font-weight: 700;
        }

        .link-ver-mais:hover {
            color: var(--roxo-escuro);
            text-decoration: underline;
        }

        .categorias-grade {
            display: grid;
            grid-template-columns: repeat(7, minmax(0, 1fr));
            gap: 13px;
        }

        .categoria {
            min-width: 0;
            min-height: 126px;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 16px 8px;
            border: 1px solid var(--borda);
            border-radius: 17px;
            background: white;
            text-align: center;
            transition: transform 0.2s, box-shadow 0.2s, border-color 0.2s;
        }

        .categoria:hover {
            transform: translateY(-3px);
            border-color: #d9cafa;
            box-shadow: var(0 8px 28px rgba(49, 35, 91, 0.06));
        }

        .categoria-icone {
            width: 51px;
            height: 51px;
            display: grid;
            place-items: center;
            border-radius: 16px;
            font-size: 25px;
        }

        .categoria span:last-child {
            font-size: 12px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

        .cor-lilas { background: #f0eaff; }
        .cor-pessego { background: #fff0e5; }
        .cor-azul { background: #e8f2ff; }
        .cor-verde { background: #e7f7ed; }
        .cor-rosa { background: #ffedf3; }
        .cor-amarelo { background: #fff5d9; }
        .cor-cinza { background: #eef0f6; }

        .necessidades {
            display: grid;
            grid-template-columns: 1.1fr 1fr;
            gap: 24px;
            align-items: center;
            padding: 25px;
            border: 1px solid var(--borda);
            border-radius: 20px;
            background: white;
            box-shadow: var(0 8px 28px rgba(49, 35, 91, 0.06));
        }

        .necessidades h2 {
            margin: 0 0 7px;
            font-size: 20px;
        }

        .necessidades p {
            margin: 0;
            color: var(#77748b);
            font-size: 13px;
            line-height: 1.7;
        }

        .necessidades-icone {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 12px;
            color: var(--roxo);
            font-size: 12px;
            font-weight: 800;
        }

        .chips {
            display: flex;
            flex-wrap: wrap;
            gap: 9px;
        }

        .chip {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 9px 12px;
            border: 1px solid #e5dcf8;
            border-radius: 999px;
            background: #faf8ff;
            color: #5f4a89;
            font-size: 12px;
            font-weight: 600;
        }

        .locais-grade {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 18px;
        }

        .local-card {
            min-width: 0;
            overflow: hidden;
            border: 1px solid var(--borda);
            border-radius: 18px;
            background: white;
            box-shadow: var(0 8px 28px rgba(49, 35, 91, 0.06));
            transition: transform 0.2s, box-shadow 0.2s;
        }

        .local-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 12px 32px rgba(49, 35, 91, 0.1);
        }

        .local-arte {
            min-height: 135px;
            display: grid;
            place-items: center;
            position: relative;
            overflow: hidden;
        }

        .local-arte::before,
        .local-arte::after {
            content: "";
            position: absolute;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.3);
        }

        .local-arte::before {
            width: 125px;
            height: 125px;
            top: -45px;
            right: -15px;
        }

        .local-arte::after {
            width: 80px;
            height: 80px;
            bottom: -35px;
            left: 15px;
        }

        .local-emoji {
            position: relative;
            z-index: 1;
            width: 76px;
            height: 76px;
            display: grid;
            place-items: center;
            border: 1px solid rgba(255,255,255,0.7);
            border-radius: 24px;
            background: rgba(255,255,255,0.72);
            font-size: 37px;
            box-shadow: 0 6px 18px rgba(40, 30, 70, 0.06);
        }

        .arte-biblioteca { background: #dff2e7; }
        .arte-cafe { background: #ffeadc; }
        .arte-parque { background: #e4eaff; }

        .local-corpo {
            padding: 17px;
        }

        .local-categoria {
            display: inline-block;
            margin-bottom: 7px;
            color: var(--roxo);
            font-size: 10px;
            font-weight: 800;
            letter-spacing: 0.7px;
            text-transform: uppercase;
        }

        .local-corpo h3 {
            margin: 0 0 7px;
            font-size: 16px;
            overflow-wrap: anywhere;
        }

        .local-descricao {
            min-height: 39px;
            margin: 0 0 13px;
            color: var(#77748b);
            font-size: 12px;
            line-height: 1.6;
        }

        .local-recursos {
            display: flex;
            flex-wrap: wrap;
            gap: 6px;
        }

        .recurso-tag {
            padding: 5px 8px;
            border-radius: 7px;
            background: #f0eaff;
            color: #6045a0;
            font-size: 10px;
            font-weight: 600;
        }

        .recurso-tag.verde {
            background: #e5f6ed;
            color: #28734c;
        }

        .recurso-tag.laranja {
            background: #fff0e5;
            color: #9b5b2c;
        }

        .experiencias {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 16px;
        }

        .experiencia-card {
            display: flex;
            gap: 14px;
            align-items: flex-start;
            padding: 21px;
            border: 1px solid var(--borda);
            border-radius: 16px;
            background: white;
        }

        .experiencia-icone {
            width: 43px;
            height: 43px;
            flex-shrink: 0;
            display: grid;
            place-items: center;
            border-radius: 14px;
            background: #f0eaff;
            font-size: 21px;
        }

        .experiencia-card h3 {
            margin: 0 0 5px;
            font-size: 14px;
        }

        .experiencia-card p {
            margin: 0;
            color: var(#77748b);
            font-size: 12px;
            line-height: 1.65;
        }

        .rodape {
            padding: 24px 0;
            border-top: 1px solid var(--borda);
            background: white;
        }

        .rodape-interno {
            width: min(1180px, calc(100% - 48px));
            margin: 0 auto;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 20px;
        }

        .rodape p {
            margin: 0;
            color: var(#77748b);
            font-size: 11px;
        }

        .rodape .marca {
            font-size: 14px;
        }

        .rodape .marca-icone {
            width: 30px;
            height: 30px;
            border-radius: 10px;
            font-size: 17px;
        }

        .sem-resultados {
            display: none;
            padding: 22px;
            border: 1px dashed #d6c9f1;
            border-radius: 15px;
            color: var(#77748b);
            background: white;
            text-align: center;
            font-size: 13px;
        }

        .sem-resultados.visivel {
            display: block;
        }

        .local-card.oculto {
            display: none;
        }

        @@media (max-width: 1000px) {
            .cabecalho-interno,
            .pagina,
            .rodape-interno {
                width: min(100% - 32px, 800px);
            }

            .cabecalho-interno {
                min-height: auto;
                padding: 14px 0;
                align-items: flex-start;
            }

            .menu {
                gap: 4px;
            }

            .menu-link {
                padding: 8px;
                font-size: 12px;
            }

            .categorias-grade {
                grid-template-columns: repeat(4, minmax(0, 1fr));
            }

            .necessidades {
                grid-template-columns: 1fr;
                gap: 18px;
            }

            .locais-grade {
                grid-template-columns: repeat(2, minmax(0, 1fr));
            }

            .locais-grade .local-card:last-child {
                display: none;
            }
        }

        @@media (max-width: 650px) {
            html {
                scroll-padding-top: 135px;
            }

            .cabecalho {
                position: sticky;
            }

            .cabecalho-interno {
                width: calc(100% - 28px);
                flex-direction: column;
                gap: 12px;
                padding: 12px 0 10px;
            }

            .marca {
                font-size: 17px;
            }

            .marca-icone {
                width: 35px;
                height: 35px;
            }

            .menu {
                width: 100%;
                display: flex;
                flex-wrap: nowrap;
                justify-content: flex-start;
                overflow-x: auto;
                padding: 0 0 4px;
                scrollbar-width: thin;
            }

            .menu-link {
                flex-shrink: 0;
                min-height: 37px;
                padding: 8px 10px;
                font-size: 12px;
            }

            .menu-perfil {
                flex-shrink: 0;
                width: 35px;
                height: 35px;
            }

            .menu-sair {
                flex-shrink: 0;
                padding: 8px 10px;
                font-size: 12px;
            }

            .pagina {
                width: calc(100% - 28px);
                padding-top: 25px;
                padding-bottom: 34px;
            }

            .boas-vindas {
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
                margin-bottom: 21px;
            }

            .boas-vindas h1 {
                font-size: 28px;
            }

            .aviso-demo {
                font-size: 11px;
            }

            .hero-pesquisa {
                padding: 24px 18px;
                margin-bottom: 27px;
                border-radius: 20px;
            }

            .hero-pesquisa h2 {
                font-size: clamp(28px, 8vw, 36px);
                letter-spacing: -1px;
            }

            .hero-pesquisa .descricao {
                font-size: 13px;
            }

            .pesquisa-form {
                flex-wrap: wrap;
                gap: 5px;
                padding: 8px;
            }

            .pesquisa-icone {
                padding-left: 6px;
            }

            .pesquisa-form input {
                flex-basis: calc(100% - 50px);
                padding: 10px 4px;
                font-size: 16px;
            }

            .pesquisa-form .botao-principal {
                width: 100%;
                min-height: 44px;
            }

            .secao {
                margin-top: 29px;
            }

            .secao-cabecalho {
                align-items: flex-start;
                margin-bottom: 15px;
            }

            .secao-cabecalho h2 {
                font-size: 19px;
            }

            .secao-cabecalho p {
                font-size: 12px;
            }

            .categorias-grade {
                grid-template-columns: repeat(2, minmax(0, 1fr));
                gap: 10px;
            }

            .categoria {
                min-height: 104px;
                flex-direction: row;
                justify-content: flex-start;
                padding: 13px;
                gap: 11px;
                text-align: left;
                border-radius: 14px;
            }

            .categoria-icone {
                width: 43px;
                height: 43px;
                flex-shrink: 0;
                border-radius: 13px;
                font-size: 22px;
            }

            .categoria span:last-child {
                font-size: 12px;
            }

            .necessidades {
                padding: 19px 16px;
                border-radius: 17px;
            }

            .necessidades h2 {
                font-size: 18px;
            }

            .chips {
                gap: 7px;
            }

            .chip {
                padding: 8px 10px;
                font-size: 11px;
            }

            .locais-grade {
                grid-template-columns: 1fr;
                gap: 13px;
            }

            .locais-grade .local-card:last-child {
                display: block;
            }

            .local-card {
                display: grid;
                grid-template-columns: 104px minmax(0, 1fr);
                align-items: stretch;
            }

            .local-arte {
                min-height: 100%;
            }

            .local-emoji {
                width: 55px;
                height: 55px;
                border-radius: 18px;
                font-size: 28px;
            }

            .local-corpo {
                padding: 13px;
            }

            .local-corpo h3 {
                font-size: 14px;
            }

            .local-descricao {
                min-height: auto;
                margin-bottom: 10px;
                font-size: 11px;
            }

            .recurso-tag {
                font-size: 9px;
            }

            .experiencias {
                grid-template-columns: 1fr;
                gap: 11px;
            }

            .experiencia-card {
                padding: 16px;
            }

            .rodape-interno {
                width: calc(100% - 28px);
                align-items: flex-start;
                flex-direction: column;
                gap: 12px;
            }
        }

        @@media (max-width: 360px) {
            .pagina {
                width: calc(100% - 22px);
            }

            .hero-pesquisa {
                padding: 21px 14px;
            }

            .categoria {
                padding: 10px 8px;
                gap: 8px;
            }

            .categoria-icone {
                width: 37px;
                height: 37px;
                font-size: 19px;
            }

            .categoria span:last-child {
                font-size: 11px;
            }

            .local-card {
                grid-template-columns: 85px minmax(0, 1fr);
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            html {
                scroll-behavior: auto;
            }

            *, *::before, *::after {
                transition: none !important;
            }
        }
    </style>
</head>

<body>

<a class="pular-conteudo" href="#conteudo">
    Pular para o conteúdo principal
</a>

<header class="cabecalho">
    <div class="cabecalho-interno">

        <a href="#inicio" class="marca" aria-label="Visto por Mim — início">
            <span class="marca-icone" aria-hidden="true">V</span>

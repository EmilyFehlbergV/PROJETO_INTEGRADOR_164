<script>
    const formPesquisa = document.getElementById("formPesquisa");
    const campoPesquisa = document.getElementById("campoPesquisa");
    const locais = Array.from(document.querySelectorAll(".local-card"));
    const semResultados = document.getElementById("semResultados");
    const categorias = document.querySelectorAll("[data-categoria]");

    function normalizar(texto) {
        return texto
            .toLowerCase()
            .normalize("NFD")
            .replace(/[\u0300-\u036f]/g, "")
            .trim();
    }

    function filtrarLocais(termo, categoria) {
        let encontrados = 0;

        locais.forEach(function (local) {
            const nome = normalizar(local.dataset.nome);
            const tipo = normalizar(local.dataset.categoria);
            const textoLocal = normalizar(local.textContent);

            const correspondeTexto =
                !termo ||
                nome.includes(termo) ||
                tipo.includes(termo) ||
                textoLocal.includes(termo);

            const correspondeCategoria =
                !categoria || tipo === normalizar(categoria);

            const mostrar = correspondeTexto && correspondeCategoria;

            local.classList.toggle("oculto", !mostrar);

            if (mostrar) {
                encontrados++;
            }
        });

        semResultados.classList.toggle("visivel", encontrados === 0);
    }

    formPesquisa.addEventListener("submit", function (evento) {
        evento.preventDefault();

        filtrarLocais(normalizar(campoPesquisa.value), "");

        document.getElementById("locais").scrollIntoView({
            behavior: "smooth",
            block: "start"
        });
    });

    campoPesquisa.addEventListener("input", function () {
        if (this.value.trim() === "") {
            filtrarLocais("", "");
        }
    });

    categorias.forEach(function (categoria) {
        categoria.addEventListener("click", function (evento) {
            evento.preventDefault();

            const tipo = this.dataset.categoria;

            if (tipo === "shoppings" ||
                tipo === "hospitais" ||
                tipo === "supermercados" ||
                tipo === "escolas") {
                filtrarLocais("", tipo);
            } else {
                filtrarLocais("", tipo);
            }

            campoPesquisa.value = "";

            document.getElementById("locais").scrollIntoView({
                behavior: "smooth",
                block: "start"
            });
        });
    });
</script>

</body>
</html>

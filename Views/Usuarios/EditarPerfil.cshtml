@model VistoPorMim.Models.Usuario

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f5f0ff" />
    <title>Editar perfil - Visto por Mim</title>

    <style>
        * {
            box-sizing: border-box;
        }

        html {
            -webkit-text-size-adjust: 100%;
        }

        body {
            margin: 0;
            min-height: 100vh;
            padding: 36px 18px;
            font-family: Arial, Helvetica, sans-serif;
            background: linear-gradient(135deg, #f3e8ff, #e0e7ff, #f5f3ff);
            color: #292344;
        }

        .container {
            width: 100%;
            max-width: 680px;
            margin: 0 auto;
            padding: 36px;
            background: #ffffff;
            border: 1px solid rgba(196, 181, 253, 0.45);
            border-radius: 24px;
            box-shadow: 0 15px 45px rgba(76, 29, 149, 0.13);
        }

        .topo {
            text-align: center;
            margin-bottom: 30px;
        }

        .icone-topo {
            display: flex;
            align-items: center;
            justify-content: center;
            width: 54px;
            height: 54px;
            margin: 0 auto 16px;
            border-radius: 17px;
            background: #f0e9ff;
            color: #6d28d9;
            font-size: 25px;
        }

        .topo h1 {
            margin: 0 0 10px;
            font-size: clamp(25px, 4vw, 32px);
            line-height: 1.2;
            color: #6d28d9;
        }

        .topo p {
            margin: 0 auto;
            max-width: 440px;
            color: #77718b;
            font-size: 15px;
            line-height: 1.6;
        }

        .foto-area {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 14px;
            margin-bottom: 32px;
            padding: 28px 22px;
            background: #faf7ff;
            border: 2px dashed #c4b5fd;
            border-radius: 20px;
            text-align: center;
        }

        .foto-preview {
            width: 132px;
            height: 132px;
            flex: 0 0 auto;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: linear-gradient(135deg, #8b5cf6, #6366f1);
            color: white;
            font-size: 48px;
            font-weight: bold;
            border: 4px solid white;
            box-shadow: 0 5px 20px rgba(109, 40, 217, 0.20);
        }

        .foto-preview img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .foto-titulo {
            margin: 3px 0 0;
            font-size: 19px;
            font-weight: bold;
            color: #4c1d95;
        }

        .foto-ajuda {
            margin: 0;
            width: 100%;
            max-width: 390px;
            color: #77718b;
            font-size: 14px;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }

        .botao-foto {
            display: inline-block;
            max-width: 100%;
            padding: 12px 20px;
            background: #ede9fe;
            border: 1px solid #c4b5fd;
            border-radius: 12px;
            color: #6d28d9;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s, transform 0.2s;
            -webkit-tap-highlight-color: transparent;
        }

        .botao-foto:hover {
            background: #ddd6fe;
            transform: translateY(-1px);
        }

        .botao-foto:focus-visible {
            outline: 3px solid #8b5cf6;
            outline-offset: 3px;
        }

        #fotoArquivo {
            display: none;
        }

        #nomeArquivo {
            display: block;
            width: 100%;
            max-width: 100%;
            overflow-wrap: anywhere;
            color: #6d28d9;
            font-size: 13px;
            line-height: 1.5;
        }

        .separador {
            width: 100%;
            height: 1px;
            margin: 5px 0 0;
            background: #e9e2fa;
        }

        .dica-foto {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            width: 100%;
            max-width: 390px;
            padding: 11px 13px;
            border-radius: 12px;
            background: #f0eaff;
            color: #5b4b83;
            text-align: left;
            font-size: 12px;
            line-height: 1.6;
        }

        .dica-foto span:first-child {
            flex-shrink: 0;
        }

        .campo {
            margin-bottom: 22px;
        }

        .campo label {
            display: block;
            margin-bottom: 9px;
            color: #3f365c;
            font-weight: bold;
            font-size: 14px;
        }

        .campo input,
        .campo textarea {
            display: block;
            width: 100%;
            min-width: 0;
            padding: 14px;
            border: 1px solid #ddd6fe;
            border-radius: 12px;
            background: #fff;
            color: #292344;
            font-family: inherit;
            font-size: 16px;
            outline: none;
            transition: border-color 0.2s, box-shadow 0.2s;
        }

        .campo input:focus,
        .campo textarea:focus {
            border-color: #8b5cf6;
            box-shadow: 0 0 0 3px rgba(139, 92, 246, 0.12);
        }

        .campo input[readonly] {
            background: #f5f3ff;
            color: #77718b;
        }

        .campo textarea {
            min-height: 125px;
            resize: vertical;
            line-height: 1.6;
        }

        .contador {
            display: block;
            margin-top: 7px;
            text-align: right;
            color: #77718b;
            font-size: 12px;
        }

        .mensagem-erro {
            margin-bottom: 22px;
            padding: 14px 16px;
            border-radius: 12px;
            background: #fef2f2;
            border: 1px solid #fecaca;
            color: #b91c1c;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

        .botoes {
            display: flex;
            gap: 13px;
            margin-top: 30px;
        }

        .botao {
            flex: 1;
            min-width: 0;
            min-height: 49px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 14px 18px;
            border: none;
            border-radius: 12px;
            text-decoration: none;
            font-family: inherit;
            font-weight: bold;
            font-size: 15px;
            text-align: center;
            cursor: pointer;
            transition: filter 0.2s, background 0.2s;
        }

        .botao-salvar {
            background: linear-gradient(135deg, #7c3aed, #6366f1);
            color: white;
        }

        .botao-salvar:hover {
            filter: brightness(1.06);
        }

        .botao-voltar {
            background: #f3f0ff;
            color: #6d28d9;
        }

        .botao-voltar:hover {
            background: #e9e2ff;
        }

        .botao:focus-visible {
            outline: 3px solid #8b5cf6;
            outline-offset: 3px;
        }

        .observacao {
            margin: 20px 0 0;
            text-align: center;
            color: #88819b;
            font-size: 12px;
            line-height: 1.6;
        }

        @@media (max-width: 600px) {
            body {
                padding: 16px 12px;
            }

            .container {
                padding: 25px 18px;
                border-radius: 20px;
            }

            .topo {
                margin-bottom: 25px;
            }

            .topo p {
                font-size: 14px;
            }

            .foto-area {
                padding: 24px 14px;
                gap: 13px;
                margin-bottom: 28px;
            }

            .foto-preview {
                width: 116px;
                height: 116px;
                font-size: 42px;
            }

            .foto-titulo {
                font-size: 18px;
            }

            .foto-ajuda {
                font-size: 13px;
            }

            .campo {
                margin-bottom: 20px;
            }

            .campo input,
            .campo textarea {
                padding: 13px 12px;
            }

            .botoes {
                flex-direction: column-reverse;
                gap: 10px;
                margin-top: 26px;
            }

            .botao {
                width: 100%;
                min-height: 48px;
            }

            .observacao {
                font-size: 12px;
            }
        }

        @@media (max-width: 360px) {
            .container {
                padding: 22px 14px;
            }

            .foto-area {
                padding: 20px 10px;
            }

            .foto-preview {
                width: 104px;
                height: 104px;
            }

            .botao-foto {
                padding: 12px 16px;
            }
        }

        @@media (prefers-reduced-motion: reduce) {
            *,
            *::before,
            *::after {
                scroll-behavior: auto !important;
                transition: none !important;
            }
        }
    </style>
</head>

<body>
    <main class="container">

        <header class="topo">
            <div class="icone-topo" aria-hidden="true">✿</div>
            <h1>Editar meu perfil</h1>
            <p>Deixe seu perfil com a sua cara. Atualize suas informações quando quiser.</p>
        </header>

        @if (ViewData["Erro"] != null)
        {
            <div class="mensagem-erro" role="alert">
                @ViewData["Erro"]
            </div>
        }

        <form asp-controller="Usuarios"
              asp-action="EditarPerfil"
              method="post"
              enctype="multipart/form-data">

            @Html.AntiForgeryToken()

            <section class="foto-area" aria-labelledby="tituloFoto">
                <div class="foto-preview" id="fotoPreview">
                    @if (!string.IsNullOrWhiteSpace(Model.FotoPerfil))
                    {
                        <img src="@Model.FotoPerfil"
                             alt="Foto de perfil atual"
                             id="imagemPreview" />
                    }
                    else
                    {
                        <span id="letraPreview">
                            @(string.IsNullOrWhiteSpace(Model.Nome)
                                ? "?"
                                : Model.Nome.Substring(0, 1).ToUpper())
                        </span>
                    }
                </div>

                <p class="foto-titulo" id="tituloFoto">Sua foto de perfil</p>

                <p class="foto-ajuda">
                    Escolha uma foto da galeria do seu celular ou dos arquivos do computador.
                    Você poderá visualizar a imagem antes de salvar.
                </p>

                <label for="fotoArquivo" class="botao-foto">
                    Escolher foto
                </label>

                <input type="file"
                       id="fotoArquivo"
                       name="fotoArquivo"
                       accept=".jpg,.jpeg,.png,.webp,image/jpeg,image/png,image/webp" />

                <span id="nomeArquivo" aria-live="polite"></span>

                <div class="separador"></div>

                <p class="foto-ajuda">
                    Formatos aceitos: JPG, PNG ou WebP. Tamanho máximo: 2 MB.
                </p>

                <div class="dica-foto">
                    <span aria-hidden="true">💡</span>
                    <span>Depois de escolher sua foto, confira a prévia e clique em “Salvar alterações” para guardar a mudança.</span>
                </div>
            </section>

            <div class="campo">
                <label for="nome">Nome completo</label>
                <input type="text"
                       id="nome"
                       name="nome"
                       value="@Model.Nome"
                       maxlength="100"
                       autocomplete="name"
                       required />
            </div>

            <div class="campo">
                <label for="email">E-mail</label>
                <input type="email"
                       id="email"
                       value="@Model.Email"
                       autocomplete="email"
                       readonly />
            </div>

            <div class="campo">
                <label for="telefone">Telefone</label>
                <input type="tel"
                       id="telefone"
                       name="telefone"
                       value="@Model.Telefone"
                       placeholder="Digite seu telefone"
                       autocomplete="tel"
                       inputmode="tel" />
            </div>

            <div class="campo">
                <label for="biografia">Sobre mim</label>
                <textarea id="biografia"
                          name="biografia"
                          maxlength="500"
                          placeholder="Conte um pouco sobre você...">@Model.Biografia</textarea>

                <span class="contador">
                    <span id="quantidade">@(Model.Biografia?.Length ?? 0)</span>/500 caracteres
                </span>
            </div>

            <div class="botoes">
                <a asp-controller="Usuarios"
                   asp-action="Perfil"
                   class="botao botao-voltar">
                    Voltar
                </a>

                <button type="submit" class="botao botao-salvar">
                    Salvar alterações
                </button>
            </div>

            <p class="observacao">
                Suas informações pessoais são mantidas na sua conta.
            </p>
        </form>
    </main>

    <script>
        const campoFoto = document.getElementById("fotoArquivo");
        const fotoPreview = document.getElementById("fotoPreview");
        const nomeArquivo = document.getElementById("nomeArquivo");
        const campoBiografia = document.getElementById("biografia");
        const quantidade = document.getElementById("quantidade");

        let urlTemporaria = null;

        campoFoto.addEventListener("change", function () {
            const arquivo = this.files[0];

            if (!arquivo) {
                nomeArquivo.textContent = "";
                return;
            }

            const extensao = arquivo.name.split(".").pop().toLowerCase();
            const extensoesPermitidas = ["jpg", "jpeg", "png", "webp"];

            if (!extensoesPermitidas.includes(extensao)) {
                alert("Escolha uma imagem JPG, PNG ou WebP.");
                this.value = "";
                nomeArquivo.textContent = "";
                return;
            }

            if (arquivo.size > 2 * 1024 * 1024) {
                alert("A foto deve ter no máximo 2 MB.");
                this.value = "";
                nomeArquivo.textContent = "";
                return;
            }

            if (urlTemporaria) {
                URL.revokeObjectURL(urlTemporaria);
                urlTemporaria = null;
            }

            urlTemporaria = URL.createObjectURL(arquivo);

            const imagem = new Image();

            imagem.onload = function () {
                fotoPreview.replaceChildren(imagem);
                imagem.alt = "Pré-visualização da foto escolhida";
                imagem.style.width = "100%";
                imagem.style.height = "100%";
                imagem.style.objectFit = "cover";
            };

            imagem.onerror = function () {
                alert("Não foi possível visualizar essa imagem. Escolha outra.");
                campoFoto.value = "";
                nomeArquivo.textContent = "";

                if (urlTemporaria) {
                    URL.revokeObjectURL(urlTemporaria);
                    urlTemporaria = null;
                }
            };

            imagem.src = urlTemporaria;
            nomeArquivo.textContent = arquivo.name;
        });

        campoBiografia.addEventListener("input", function () {
            quantidade.textContent = this.value.length;
        });

        window.addEventListener("beforeunload", function () {
            if (urlTemporaria) {
                URL.revokeObjectURL(urlTemporaria);
            }
        });
    </script>
</body>
</html>

@model List<VistoPorMim.Models.Usuario>

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Usuários</title>
</head>
<body>

<h1>Usuários cadastrados</h1>

@if (Model.Count == 0)
{
    <p>Nenhum usuário cadastrado.</p>
}
else
{
    <ul>
        @foreach (var usuario in Model)
        {
            <li>
                @usuario.Nome - @usuario.Email
            </li>
        }
    </ul>
}

</body>
</html>
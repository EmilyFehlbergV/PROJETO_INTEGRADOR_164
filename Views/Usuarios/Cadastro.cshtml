@model VistoPorMim.Models.Usuario

@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Cadastro de Usuário</title>
</head>

<body>

<h1>Cadastro de Usuário</h1>

<div asp-validation-summary="All" style="color: red;"></div>

<form asp-action="Cadastro" method="post">
    @Html.AntiForgeryToken()

    <div>
        <label asp-for="Nome">Nome</label>
        <input asp-for="Nome" />
        <span asp-validation-for="Nome" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Email">E-mail</label>
        <input asp-for="Email" type="email" />
        <span asp-validation-for="Email" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Senha">Senha</label>
        <input asp-for="Senha" type="password" />
        <span asp-validation-for="Senha" style="color: red;"></span>
    </div>

    <div>
        <label asp-for="Telefone">Telefone</label>
        <input asp-for="Telefone" />
        <span asp-validation-for="Telefone" style="color: red;"></span>
    </div>

    <button type="submit">Cadastrar</button>
</form>

</body>
</html>